@inject IJSRuntime JS
@implements IAsyncDisposable

<EditForm Model="@this" OnValidSubmit="@SendMessageAsync">
    <div class="chat-input-box">
        <textarea @ref="@_textArea"
                  @bind="@_messageText"
                  @bind:event="oninput"
                  placeholder="Type your message..."
                  rows="1"
                  disabled="@Disabled"></textarea>
        <button type="submit" title="Send" class="send-btn" disabled="@(Disabled || string.IsNullOrWhiteSpace(_messageText))">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
            </svg>
        </button>
    </div>
</EditForm>

@code {
    private ElementReference _textArea;
    private string? _messageText;
    private IJSObjectReference? _module;
    private IJSObjectReference? _enterToSendHandle;
    private DotNetObjectReference<ChatInput>? _dotNetRef;

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    public ValueTask FocusAsync() => _textArea.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Enter-to-send with Shift+Enter for a newline needs a plain JS keydown listener - Blazor's
        // @onkeydown:preventDefault can't conditionally target just the Enter key without also
        // blocking normal character entry in the textarea.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Chat/ChatInput.razor.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        _enterToSendHandle = await _module.InvokeAsync<IJSObjectReference>("attachEnterToSend", _textArea, _dotNetRef);
    }

    [JSInvokable]
    public async Task SubmitFromJsAsync() => await SendMessageAsync();

    private async Task SendMessageAsync()
    {
        if (_messageText is { Length: > 0 } text && !Disabled)
        {
            _messageText = null;

            // SubmitFromJsAsync is invoked directly by the JS keydown listener, outside Blazor's
            // normal synthetic-event dispatch pipeline, so clearing _messageText above doesn't
            // trigger a render on its own - force one now so the textarea clears immediately
            // instead of waiting for the next unrelated render (e.g. the first streamed chunk).
            StateHasChanged();

            await OnSend.InvokeAsync(text);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_enterToSendHandle is not null)
        {
            await _enterToSendHandle.InvokeVoidAsync("dispose");
            await _enterToSendHandle.DisposeAsync();
        }

        if (_module is not null)
            await _module.DisposeAsync();

        _dotNetRef?.Dispose();
    }
}
