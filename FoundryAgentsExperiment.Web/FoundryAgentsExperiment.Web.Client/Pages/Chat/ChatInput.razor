@inject IJSRuntime JS
@implements IAsyncDisposable

<EditForm Model="@this" OnValidSubmit="@SendMessageAsync">
    <div class="chat-input-box">
        <textarea @ref="@textArea"
                  @bind="@messageText"
                  @bind:event="oninput"
                  placeholder="Type your message..."
                  rows="1"
                  disabled="@Disabled"></textarea>
        @if (IsStreaming)
        {
            <button type="button" title="Stop generating" class="send-btn stop-btn" @onclick="OnStop">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="7" y="7" width="10" height="10" rx="1" />
                </svg>
            </button>
        }
        else
        {
            <button type="submit" title="Send" class="send-btn" disabled="@(Disabled || string.IsNullOrWhiteSpace(messageText))">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                </svg>
            </button>
        }
    </div>
</EditForm>

@code {
    private ElementReference textArea;
    private string? messageText;
    private IJSObjectReference? module;
    private IJSObjectReference? enterToSendHandle;
    private DotNetObjectReference<ChatInput>? dotNetRef;

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsStreaming { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    public ValueTask FocusAsync() => this.textArea.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Enter-to-send with Shift+Enter for a newline needs a plain JS keydown listener - Blazor's
        // @onkeydown:preventDefault can't conditionally target just the Enter key without also
        // blocking normal character entry in the textarea.
        this.module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Chat/ChatInput.razor.js");
        this.dotNetRef = DotNetObjectReference.Create(this);
        this.enterToSendHandle = await this.module.InvokeAsync<IJSObjectReference>("attachEnterToSend", this.textArea, this.dotNetRef);
    }

    [JSInvokable]
    public async Task SubmitFromJsAsync() => await SendMessageAsync();

    private async Task SendMessageAsync()
    {
        if (this.messageText is { Length: > 0 } text && !Disabled)
        {
            this.messageText = null;

            // SubmitFromJsAsync is invoked directly by the JS keydown listener, outside Blazor's
            // normal synthetic-event dispatch pipeline, so clearing messageText above doesn't
            // trigger a render on its own - force one now so the textarea clears immediately
            // instead of waiting for the next unrelated render (e.g. the first streamed chunk).
            StateHasChanged();

            await OnSend.InvokeAsync(text);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (this.enterToSendHandle is not null)
        {
            await this.enterToSendHandle.InvokeVoidAsync("dispose");
            await this.enterToSendHandle.DisposeAsync();
        }

        if (this.module is not null)
            await this.module.DisposeAsync();

        this.dotNetRef?.Dispose();
    }
}
