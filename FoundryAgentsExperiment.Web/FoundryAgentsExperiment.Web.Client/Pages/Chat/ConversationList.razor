<div class="conversation-list">
    <div class="conversation-list-header">Conversations</div>

    @if (IsLoading)
    {
        <div class="conversation-list-loading">Loading conversations…</div>
    }
    else
    {
        @if (ShowNewConversationPlaceholder)
        {
            <div class="conversation-item active">
                <div class="conversation-title">New conversation</div>
                <div class="conversation-date">just now</div>
            </div>
        }

        @if (Conversations.Count == 0 && !ShowNewConversationPlaceholder)
        {
            <div class="conversation-list-empty">No previous conversations</div>
        }

        @foreach (var conversation in Conversations)
        {
            var itemClass = conversation.Id == ActiveConversationId
                ? "conversation-item active"
                : "conversation-item";
            <div class="@itemClass"
                 @onclick="@(() => OnSelected.InvokeAsync(conversation))"
                 aria-busy="@(IsLoadingConversation && conversation.Id == ActiveConversationId)">
                <div class="conversation-title">@conversation.Title</div>
                <div class="conversation-date">@FormatDate(conversation.LastUpdatedAt)</div>
                <button type="button"
                        class="conversation-delete"
                        title="Delete conversation"
                        @onclick="@(() => OnDeleted.InvokeAsync(conversation))"
                        @onclick:stopPropagation="true">
                    ×
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<ConversationSummary> Conversations { get; set; } = [];

    [Parameter]
    public string? ActiveConversationId { get; set; }

    [Parameter]
    public EventCallback<ConversationSummary> OnSelected { get; set; }

    [Parameter]
    public EventCallback<ConversationSummary> OnDeleted { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsLoadingConversation { get; set; }

    [Parameter]
    public bool ShowNewConversationPlaceholder { get; set; }

    private static string FormatDate(DateTimeOffset date)
    {
        var now = DateTimeOffset.UtcNow;
        var diff = now - date;
        return diff.TotalMinutes < 1 ? "just now"
            : diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes}m ago"
            : diff.TotalDays < 1 ? $"{(int)diff.TotalHours}h ago"
            : diff.TotalDays < 7 ? $"{(int)diff.TotalDays}d ago"
            : date.ToString("MMM d");
    }
}
