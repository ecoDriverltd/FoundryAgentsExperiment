@using System.Runtime.CompilerServices

@if (Message.Role == ChatRole.User)
{
    <div class="user-message">
        @Message.Text
    </div>
}
else if (Message.Role == ChatRole.Assistant && !HasToolContent)
{
    <div class="assistant-message">
        <div class="assistant-message-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
        </div>
        <div class="assistant-message-body">
            <div class="assistant-message-header">Assistant</div>
            <div class="assistant-message-text">@((MarkupString)RenderMarkdown(MessageText))</div>
        </div>
    </div>
}
else if (Message.Role == ChatRole.Tool || HasToolContent)
{
    <div class="tool-message">
        @foreach (var content in Message.Contents)
        {
            @switch (content)
            {
                case TextContent text:
                    @text.Text
                    break;
                case FunctionCallContent call:
                    <span>🔧 Calling @call.Name…</span>
                    break;
                case FunctionResultContent result:
                    <span>✅ @result.Result</span>
                    break;
            }
        }
    </div>
}

@code {
    private static readonly ConditionalWeakTable<ChatMessage, ChatMessageItem> SubscribersLookup = new();

    [Parameter, EditorRequired]
    public required ChatMessage Message { get; set; }

    [Parameter]
    public bool InProgress { get; set; }

    private string MessageText => string.Concat(Message.Contents.OfType<TextContent>().Select(content => content.Text));

    private bool HasToolContent => Message.Contents.Any(content =>
        content is FunctionCallContent or FunctionResultContent);

    protected override void OnInitialized()
    {
        SubscribersLookup.AddOrUpdate(Message, this);
    }

    public static void NotifyChanged(ChatMessage source)
    {
        if (SubscribersLookup.TryGetValue(source, out var subscriber))
            subscriber.StateHasChanged();
    }

    // Minimal markdown: bold, italic, inline code, line breaks
    private static string RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var html = System.Net.WebUtility.HtmlEncode(text);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code>$1</code>");
        html = html.Replace("\n", "<br />");
        return html;
    }
}
