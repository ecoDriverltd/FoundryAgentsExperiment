@page "/chat"
@page "/chat/{ConversationId}"
@rendermode InteractiveWebAssembly

@using AGUI.Client
@using FoundryAgentsExperiment.Shared.Models
@using Microsoft.Agents.AI
@using Microsoft.Extensions.AI

@inject AGUIChatClient ChatClient
@inject GeolocationService Geolocation
@inject AgentConversationClient ConversationClient
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Chat</PageTitle>

<div class="chat-page">
    <div class="chat-sidebar">
        <ConversationList Conversations="_conversations"
                          ActiveConversationId="@_conversationId"
                          OnSelected="@ResumeConversationAsync" />
    </div>

    <div class="chat-main">
        <ChatHeader OnNewChat="@StartNewConversation" />

        <ChatMessageList Messages="@_displayMessages" InProgressMessage="@_inProgressMessage">
            <NoMessagesContent>
                <p>Start a conversation.</p>
            </NoMessagesContent>
        </ChatMessageList>

        <div class="chat-input-area">
            <ChatInput @ref="_chatInput" OnSend="@SendMessageAsync" Disabled="@_isStreaming" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ConversationId { get; set; }

    private string? _conversationId;
    private readonly AGUIContinuationState _continuation = new();
    private ChatClientAgent? _agent;
    private AgentSession? _session;
    private bool _isStreaming;
    private bool _focusInput;
    private bool _hasConversationUrl;
    private string? _loadedConversationId;

    private readonly List<ChatMessage> _displayMessages = [];
    private IReadOnlyList<ConversationSummary> _conversations = [];
    private ChatMessage? _inProgressMessage;
    private CancellationTokenSource? _streamingCts;

    private ChatInput? _chatInput;

    protected override async Task OnInitializedAsync()
    {
        // localStorage is only available after WASM is interactive
        if (!RendererInfo.IsInteractive)
            return;

        // Frontend tools are registered when the ChatClientAgent is built, so the agent (and its
        // tool list) must be constructed here rather than in DI: the geolocation tool closes over
        // this page's scoped GeolocationService (which wraps IJSRuntime, itself scoped/circuit-bound).
        AITool[] frontendTools =
        [
            AIFunctionFactory.Create(Geolocation.GetUserLocationAsync,
                name: "get_user_location",
                description: "Get the user's current location from the browser's GPS.")
        ];

        _agent = ChatClient.AsAIAgent(name: "agui-client", description: "AG-UI Client Agent", tools: frontendTools);
        await RefreshConversationsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || ConversationId == _loadedConversationId)
            return;

        _loadedConversationId = ConversationId;
        _hasConversationUrl = ConversationId is { Length: > 0 };
        if (ConversationId is not { Length: > 0 } conversationId)
            return;

        CancelStreaming();
        _conversationId = conversationId;
        _session = null;
        _inProgressMessage = null;
        _displayMessages.Clear();

        var conversation = await ConversationClient.GetConversationAsync(conversationId);
        _continuation.Restore(conversation.ConversationId, conversation.LastRunId);

        foreach (var message in conversation.Messages)
        {
            if (IsDisplayableMessage(message))
                _displayMessages.Add(message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
            return;

        if (firstRender || _focusInput)
        {
            _focusInput = false;
            await _chatInput!.FocusAsync();
        }
    }

    private async Task SendMessageAsync(string userText)
    {
        CancelStreaming();

        // Add to display list immediately
        var userMessage = new ChatMessage(ChatRole.User, userText)
        {
            MessageId = Guid.NewGuid().ToString("N"),
        };
        _displayMessages.Add(userMessage);

        // The server loads its own Cosmos-managed transcript; send only the fresh turn.
        if (_continuation.ThreadId is null)
        {
            _conversationId = Guid.NewGuid().ToString("N");
            _continuation.InitializeThread(_conversationId);
        }

        var responseText = new TextContent(string.Empty);
        _inProgressMessage = new ChatMessage(ChatRole.Assistant, [responseText]);
        _isStreaming = true;
        var inProgressMessage = _inProgressMessage;
        var streamingCts = new CancellationTokenSource();
        _streamingCts = streamingCts;

        // Render the assistant bubble + typing indicator immediately - otherwise nothing shows
        // until the first network round-trip (session creation, then the first streamed chunk)
        // completes, leaving a silent gap after the user's message appears.
        StateHasChanged();

        try
        {
            _session ??= await _agent!.CreateSessionAsync(streamingCts.Token);

            List<ChatMessage> messages =
            [
                userMessage
            ];

            await foreach (var update in _agent!.RunStreamingAsync(messages, _session, _continuation.CreateRunOptions(), streamingCts.Token))
            {
                _continuation.Observe(update);

                if (!_hasConversationUrl && _continuation.ThreadId is { Length: > 0 } threadId)
                {
                    _conversationId = threadId;
                    _hasConversationUrl = true;
                    await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, $"/chat/{threadId}");
                }

                foreach (var content in update.Contents)
                {
                    switch (content)
                    {
                        case TextContent text:
                            responseText.Text += text.Text;
                            ChatMessageItem.NotifyChanged(inProgressMessage);
                            break;
                        case FunctionCallContent call:
                            _displayMessages.Add(new ChatMessage(ChatRole.Tool, $"🔧 Calling {call.Name}…"));
                            break;
                        case FunctionResultContent result:
                            _displayMessages.Add(new ChatMessage(ChatRole.Tool, $"✅ {result.Result}"));
                            break;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Streaming was cancelled — keep whatever was received
        }
        finally
        {
            if (ReferenceEquals(_streamingCts, streamingCts))
            {
                _displayMessages.Add(inProgressMessage);
                _inProgressMessage = null;
                _isStreaming = false;
                _streamingCts = null;
                _focusInput = true;

                if (_conversationId is { Length: > 0 } conversationId &&
                    _continuation.PreviousRunId is { Length: > 0 } runId)
                {
                    await ConversationClient.UpdateContinuationAsync(conversationId, runId, userMessage.Text);
                    await RefreshConversationsAsync();
                }

                await InvokeAsync(StateHasChanged);
            }

            streamingCts.Dispose();
        }
    }

    private void StartNewConversation()
    {
        CancelStreaming();
        _conversationId = null;
        _continuation.Reset();
        _hasConversationUrl = false;
        _session = null;
        _displayMessages.Clear();
        _inProgressMessage = null;
        Nav.NavigateTo("/chat");
    }

    private async Task ResumeConversationAsync(ConversationSummary conversation)
    {
        CancelStreaming();
        _conversationId = conversation.Id;
        _session = null;
        _displayMessages.Clear();
        _inProgressMessage = null;
        Nav.NavigateTo($"/chat/{conversation.Id}");
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsDisplayableMessage(ChatMessage message) =>
        (message.Role.Value == "user" || message.Role.Value == "assistant" || message.Role.Value == "tool") &&
        message.Contents.Any(content => content switch
        {
            TextContent { Text.Length: > 0 } => true,
            FunctionCallContent => true,
            FunctionResultContent => true,
            _ => false,
        });

    private async Task RefreshConversationsAsync() =>
        _conversations = await ConversationClient.GetConversationsAsync();

    private void CancelStreaming()
    {
        if (_inProgressMessage is not null)
            _displayMessages.Add(_inProgressMessage);

        _streamingCts?.Cancel();
        _streamingCts = null;
        _inProgressMessage = null;
        _isStreaming = false;
    }

    public void Dispose() => _streamingCts?.Cancel();
}
