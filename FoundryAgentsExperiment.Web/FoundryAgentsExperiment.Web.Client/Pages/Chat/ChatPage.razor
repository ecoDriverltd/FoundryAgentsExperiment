@page "/chat"
@page "/chat/{ConversationId}"
@rendermode InteractiveWebAssembly

@using FoundryAgentsExperiment.Shared.Models
@using Microsoft.Extensions.AI
@using System.Diagnostics
@using System.Text.Json

@inject ResponsesChatClient ChatClient
@inject AgentConversationClient ConversationClient
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Chat</PageTitle>

<div class="chat-page">
    <div class="chat-sidebar">
        <ConversationList Conversations="@conversations"
                          ActiveConversationId="@conversationId"
                          IsLoading="@isLoadingConversations"
                          IsLoadingConversation="@isLoadingConversation"
                          ShowNewConversationPlaceholder="@(!hasConversationUrl)"
                           OnSelected="@ResumeConversationAsync"
                           OnDeleted="@DeleteConversationAsync" />
    </div>

    <div class="chat-main">
        <ChatHeader OnNewChat="@StartNewConversation" />

        <ChatMessageList Messages="@displayMessages" InProgressMessage="@inProgressMessage">
            <NoMessagesContent>
                <p>@(isLoadingConversation ? "Loading conversation…" : "Start a conversation.")</p>
            </NoMessagesContent>
        </ChatMessageList>

        <div class="chat-input-area">
            <ChatInput @ref="chatInput"
                       OnSend="@SendMessageAsync"
                       OnStop="@CancelStreaming"
                       IsStreaming="@isStreaming"
                       Disabled="@isLoadingConversation" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ConversationId { get; set; }

    private string? conversationId;
    private bool isStreaming;
    private bool isLoadingConversations = true;
    private bool isLoadingConversation;
    private bool focusInput;
    private bool hasConversationUrl;
    private string? loadedConversationId;

    private readonly List<ChatMessage> displayMessages = [];
    private readonly Dictionary<string, string> functionCallNames = [];
    private IReadOnlyList<ConversationSummary> conversations = [];
    private ChatMessage? inProgressMessage;
    private CancellationTokenSource? streamingCts;

    private ChatInput? chatInput;

    protected override async Task OnInitializedAsync()
    {
        // localStorage is only available after WASM is interactive
        if (!RendererInfo.IsInteractive)
            return;

        await LoadConversationsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || ConversationId == this.loadedConversationId)
            return;

        this.loadedConversationId = ConversationId;
        this.hasConversationUrl = ConversationId is { Length: > 0 };
        if (ConversationId is not { Length: > 0 } conversationId)
            return;

        CancelStreaming();
        this.isLoadingConversation = true;
        this.conversationId = conversationId;
        this.inProgressMessage = null;
        this.displayMessages.Clear();
        this.functionCallNames.Clear();

        try
        {
            await InvokeAsync(StateHasChanged);
            var conversation = await ConversationClient.GetConversationAsync(conversationId);
            foreach (var message in conversation.Messages)
                AddDisplayMessage(message);
        }
        finally
        {
            this.isLoadingConversation = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
            return;

        if (firstRender || this.focusInput)
        {
            this.focusInput = false;
            await this.chatInput!.FocusAsync();
        }
    }

    private async Task SendMessageAsync(string userText)
    {
        var turnStopwatch = Stopwatch.StartNew();
        var receivedVisibleAssistantText = false;
        var lastVisibleAssistantTextAt = TimeSpan.Zero;
        Console.WriteLine($"[Timing] Chat turn started at={DateTimeOffset.UtcNow:O}");
        CancelStreaming();

        // Add to display list immediately
        var userMessage = new ChatMessage(ChatRole.User, userText)
        {
            MessageId = Guid.NewGuid().ToString("N"),
        };
        this.displayMessages.Add(userMessage);

        // The Responses host owns the transcript. Send only the current user message and the
        // standard conversation ID; no client-side history is replayed.
        var responseText = new TextContent(string.Empty);
        this.inProgressMessage = new ChatMessage(ChatRole.Assistant, [responseText]);
        this.isStreaming = true;
        var streamingMessage = this.inProgressMessage;
        var requestCancellation = new CancellationTokenSource();
        this.streamingCts = requestCancellation;
        var completed = false;

        // Render the assistant bubble + typing indicator immediately - otherwise nothing shows
        // until the first network round-trip (session creation, then the first streamed chunk)
        // completes, leaving a silent gap after the user's message appears.
        StateHasChanged();

        try
        {
            await foreach (var update in ChatClient.StreamResponseAsync(
                this.conversationId,
                userText,
                requestCancellation.Token))
            {
                switch (update.Type)
                {
                    case "response.created":
                        if (!this.hasConversationUrl && TryGetConversationId(update.Data, out var conversationId))
                        {
                            this.conversationId = conversationId;
                            this.hasConversationUrl = true;
                            await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, $"/chat/{conversationId}");
                        }
                        break;
                    case "response.output_text.delta":
                        var text = update.Data.GetProperty("delta").GetString();
                        responseText.Text += text;
                        if (!string.IsNullOrWhiteSpace(text))
                        {
                            if (!receivedVisibleAssistantText)
                            {
                                receivedVisibleAssistantText = true;
                                Console.WriteLine($"[Timing] First visible assistant text elapsedMs={turnStopwatch.ElapsedMilliseconds}");
                            }

                            lastVisibleAssistantTextAt = turnStopwatch.Elapsed;
                        }
                        break;
                    case "response.failed":
                        throw new InvalidOperationException("The Responses request failed.");
                }

                await InvokeAsync(StateHasChanged);
            }

            completed = true;
            Console.WriteLine(
                $"[Timing] Chat stream completed elapsedMs={turnStopwatch.ElapsedMilliseconds} " +
                $"afterLastVisibleTextMs={(receivedVisibleAssistantText ? (turnStopwatch.Elapsed - lastVisibleAssistantTextAt).TotalMilliseconds : 0):F0}");
        }
        catch (OperationCanceledException)
        {
            // Streaming was cancelled — keep whatever was received
        }
        finally
        {
            if (ReferenceEquals(this.streamingCts, requestCancellation))
            {
                if (!string.IsNullOrWhiteSpace(streamingMessage.Text))
                    this.displayMessages.Add(streamingMessage);

                this.inProgressMessage = null;
                this.isStreaming = false;
                this.streamingCts = null;
                this.focusInput = true;

                if (completed)
                    UpdateConversationSummary(userMessage.Text);

                await InvokeAsync(StateHasChanged);
                Console.WriteLine($"[Timing] Loading indicator cleared elapsedMs={turnStopwatch.ElapsedMilliseconds}");
            }

            requestCancellation.Dispose();
        }
    }

    private void StartNewConversation()
    {
        CancelStreaming();
        this.conversationId = null;
        this.hasConversationUrl = false;
        this.displayMessages.Clear();
        this.functionCallNames.Clear();
        this.inProgressMessage = null;
        Nav.NavigateTo("/chat");
    }

    private async Task ResumeConversationAsync(ConversationSummary conversation)
    {
        CancelStreaming();
        this.conversationId = conversation.Id;
        this.displayMessages.Clear();
        this.functionCallNames.Clear();
        this.inProgressMessage = null;
        this.isLoadingConversation = true;
        Nav.NavigateTo($"/chat/{conversation.Id}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteConversationAsync(ConversationSummary conversation)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{conversation.Title}'?");
        if (!confirmed)
            return;

        await ConversationClient.DeleteConversationAsync(conversation.Id);
        this.conversations = this.conversations
            .Where(item => item.Id != conversation.Id)
            .ToList();

        if (this.conversationId == conversation.Id)
            StartNewConversation();
    }

    private void AddDisplayMessage(ChatMessage message)
    {
        foreach (var call in message.Contents.OfType<FunctionCallContent>())
            this.functionCallNames[call.CallId] = call.Name;

        foreach (var result in message.Contents.OfType<FunctionResultContent>())
            AddVisibleToolResult(result);

        if ((message.Role == ChatRole.User || message.Role == ChatRole.Assistant) &&
            message.Contents.OfType<TextContent>().Any(content => !string.IsNullOrWhiteSpace(content.Text)))
        {
            this.displayMessages.Add(message);
        }
    }

    private void AddVisibleToolResult(FunctionResultContent result)
    {
        this.functionCallNames.TryGetValue(result.CallId, out var toolName);
        this.displayMessages.Add(new ChatMessage(ChatRole.Tool, $"🔧 {toolName ?? "Tool"}: {result.Result}"));
    }

    private void UpdateConversationSummary(string? initialUserText)
    {
        if (this.conversationId is not { Length: > 0 } currentConversationId)
            return;

        var now = DateTimeOffset.UtcNow;
        var existing = this.conversations.FirstOrDefault(conversation => conversation.Id == currentConversationId);
        var updatedConversation = existing is null
            ? new ConversationSummary(
                currentConversationId,
                Truncate(initialUserText, 60) ?? "New conversation",
                now,
                now)
            : existing with { LastUpdatedAt = now };

        this.conversations = [
            updatedConversation,
            .. this.conversations.Where(conversation => conversation.Id != currentConversationId),
        ];

    }

    private static bool TryGetConversationId(System.Text.Json.JsonElement data, out string conversationId)
    {
        conversationId = string.Empty;
        if (!data.TryGetProperty("response", out var response) ||
            !response.TryGetProperty("conversation", out var conversation))
            return false;

        conversationId = conversation.ValueKind == System.Text.Json.JsonValueKind.String
            ? conversation.GetString() ?? string.Empty
            : conversation.TryGetProperty("id", out var id) ? id.GetString() ?? string.Empty : string.Empty;
        return !string.IsNullOrWhiteSpace(conversationId);
    }

    private static string? Truncate(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        var trimmed = text.Trim();
        return trimmed.Length <= maxLength ? trimmed : trimmed[..maxLength] + "...";
    }

    private async Task LoadConversationsAsync()
    {
        this.isLoadingConversations = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            this.conversations = await ConversationClient.GetConversationsAsync();
        }
        finally
        {
            this.isLoadingConversations = false;
        }
    }

    private void CancelStreaming()
    {
        if (this.inProgressMessage is { Text.Length: > 0 })
            this.displayMessages.Add(this.inProgressMessage);

        this.streamingCts?.Cancel();
        this.streamingCts = null;
        this.inProgressMessage = null;
        this.isStreaming = false;
    }

    public void Dispose() => this.streamingCts?.Cancel();

}
