@page "/chat"
@page "/chat/{ConversationId}"
@rendermode InteractiveWebAssembly
@using Microsoft.Agents.AI
@using Microsoft.Agents.AI.AGUI
@using Microsoft.Extensions.AI
@inject AGUIChatClient ChatClient
@inject GeolocationService Geolocation
@inject ConversationStore ConversationStore
@inject UserIdentityService UserIdentity
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Chat</PageTitle>

<div class="chat-page">
    <div class="chat-sidebar">
        <ConversationList @ref="_conversationList"
                          ActiveConversationId="@_conversationId"
                          OnSelected="@ResumeConversationAsync" />
    </div>

    <div class="chat-main">
        <ChatHeader OnNewChat="@StartNewConversation" />

        <ChatMessageList Messages="@_displayMessages" InProgressMessage="@_inProgressMessage">
            <NoMessagesContent>
                <p>Start a conversation.</p>
            </NoMessagesContent>
        </ChatMessageList>

        <div class="chat-input-area">
            <ChatInput @ref="_chatInput" OnSend="@SendMessageAsync" Disabled="@_isStreaming" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ConversationId { get; set; }

    private string _conversationId = Guid.NewGuid().ToString(); // localStorage key + URL param
    private string? _threadId;                                   // server-assigned Foundry thread ID
    private ChatClientAgent? _agent;                              // built per page instance with frontend tools
    private AgentSession? _session;                               // AG-UI session bound to _threadId
    private bool _isFirstMessage = true;
    private bool _isStreaming;
    private bool _focusInput;

    private readonly List<ChatMessage> _displayMessages = [];
    private ChatMessage? _inProgressMessage;
    private CancellationTokenSource? _streamingCts;

    private ChatInput? _chatInput;
    private ConversationList? _conversationList;

    protected override async Task OnInitializedAsync()
    {
        // localStorage is only available after WASM is interactive
        if (!RendererInfo.IsInteractive)
            return;

        // Frontend tools are registered when the ChatClientAgent is built, so the agent (and its
        // tool list) must be constructed here rather than in DI: the geolocation tool closes over
        // this page's scoped GeolocationService (which wraps IJSRuntime, itself scoped/circuit-bound).
        AITool[] frontendTools =
        [
            AIFunctionFactory.Create(Geolocation.GetUserLocationAsync,
                name: "get_user_location",
                description: "Get the user's current location from the browser's GPS.")
        ];

        _agent = ChatClient.AsAIAgent(name: "agui-client", description: "AG-UI Client Agent", tools: frontendTools);

        if (ConversationId is { Length: > 0 })
        {
            // Resume: load the stored ThreadId so Foundry can replay its server-side history
            _conversationId = ConversationId;
            _isFirstMessage = false;
            var all = await ConversationStore.GetAllAsync();
            _threadId = all.FirstOrDefault(c => c.Id == ConversationId)?.ThreadId;
        }
        // else: new conversation with fresh GUID already set
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
            return;

        if (firstRender || _focusInput)
        {
            _focusInput = false;
            await _chatInput!.FocusAsync();
        }
    }

    private async Task SendMessageAsync(string userText)
    {
        CancelStreaming();

        // Add to display list immediately
        var userMessage = new ChatMessage(ChatRole.User, userText);
        _displayMessages.Add(userMessage);

        // Persist conversation on first message
        if (_isFirstMessage)
        {
            _isFirstMessage = false;
            var title = userText.Length > 60 ? userText[..60] + "…" : userText;
            var summary = new ConversationSummary
            {
                Id = _conversationId,
                Title = title
            };
            await ConversationStore.SaveAsync(summary);
            await _conversationList!.RefreshAsync();
            await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, $"/chat/{_conversationId}");
        }
        else
        {
            var all = await ConversationStore.GetAllAsync();
            var existing = all.FirstOrDefault(c => c.Id == _conversationId);
            if (existing is not null)
            {
                existing.LastMessageAt = DateTimeOffset.UtcNow;
                await ConversationStore.SaveAsync(existing);
            }
        }

        // Fresh system prompt injected every turn; Foundry maintains history server-side.
        var systemPrompt = $"""
            You are providing general assistance to a user planning their day.
            If the user asks for their location or where they are or similar, call the get_user_location tool to retrieve it.
            """;

        var responseText = new TextContent(string.Empty);
        _inProgressMessage = new ChatMessage(ChatRole.Assistant, [responseText]);
        _isStreaming = true;
        _streamingCts = new CancellationTokenSource();

        // Render the assistant bubble + typing indicator immediately - otherwise nothing shows
        // until the first network round-trip (session creation, then the first streamed chunk)
        // completes, leaving a silent gap after the user's message appears.
        StateHasChanged();

        try
        {
            // Reuse the session across turns of the same conversation; create it (resuming the
            // stored thread id, if any) the first time this page instance sends a message.
            _session ??= _threadId is { Length: > 0 }
                ? await _agent!.CreateSessionAsync(_threadId, _streamingCts.Token)
                : await _agent!.CreateSessionAsync(_streamingCts.Token);

            List<ChatMessage> messages =
            [
                new(ChatRole.System, systemPrompt),
                new(ChatRole.User, userText)
            ];

            await foreach (var update in _agent!.RunStreamingAsync(messages, _session, cancellationToken: _streamingCts.Token))
            {
                if (_threadId is null or { Length: 0 })
                {
                    var conversationId = update.AsChatResponseUpdate().ConversationId;
                    if (conversationId is { Length: > 0 })
                    {
                        _threadId = conversationId;
                        // Persist the server thread ID so resume can pass it back to Foundry
                        var all = await ConversationStore.GetAllAsync();
                        var existing = all.FirstOrDefault(c => c.Id == _conversationId);
                        if (existing is not null)
                        {
                            existing.ThreadId = conversationId;
                            await ConversationStore.SaveAsync(existing);
                        }
                    }
                }

                foreach (var content in update.Contents)
                {
                    switch (content)
                    {
                        case TextContent text:
                            responseText.Text += text.Text;
                            ChatMessageItem.NotifyChanged(_inProgressMessage);
                            break;
                        case FunctionCallContent call:
                            _displayMessages.Add(new ChatMessage(ChatRole.Tool, $"🔧 Calling {call.Name}…"));
                            break;
                        case FunctionResultContent result:
                            _displayMessages.Add(new ChatMessage(ChatRole.Tool, $"✅ {result.Result}"));
                            break;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Streaming was cancelled — keep whatever was received
        }
        finally
        {
            _displayMessages.Add(_inProgressMessage!);
            _inProgressMessage = null;
            _isStreaming = false;
            _focusInput = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartNewConversation()
    {
        CancelStreaming();
        _conversationId = Guid.NewGuid().ToString();
        _threadId = null;
        _session = null;
        _isFirstMessage = true;
        _displayMessages.Clear();
        _inProgressMessage = null;
        Nav.NavigateTo("/chat");
    }

    private async Task ResumeConversationAsync(ConversationSummary conversation)
    {
        CancelStreaming();
        _conversationId = conversation.Id;
        _threadId = conversation.ThreadId;
        _session = null;
        _isFirstMessage = false;
        _displayMessages.Clear();
        _inProgressMessage = null;
        Nav.NavigateTo($"/chat/{conversation.Id}");
        await InvokeAsync(StateHasChanged);
    }

    private void CancelStreaming()
    {
        if (_inProgressMessage is not null)
            _displayMessages.Add(_inProgressMessage);

        _streamingCts?.Cancel();
        _streamingCts = null;
        _inProgressMessage = null;
        _isStreaming = false;
    }

    public void Dispose() => _streamingCts?.Cancel();
}
